# testnet (default) or mainnet. Mainnet needs deployments/mainnet.json (scripts/deploy-mainnet.sh).
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Solver API (see services/solver). Run it with: pnpm solver
NEXT_PUBLIC_SOLVER_URL=http://localhost:8787
# Comma-separated NEAR RPC endpoints, tried in order.
NEXT_PUBLIC_NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org

# DEV ONLY (testnet): sign with a throwaway key instead of a browser wallet, for automated UI tests.
# NEXT_PUBLIC_ values are visible in the browser; never use a real key. Ignored/forbidden on mainnet.
# NEXT_PUBLIC_TEST_ACCOUNT_ID=yourname.testnet
# NEXT_PUBLIC_TEST_PRIVATE_KEY=ed25519:...
