{
  "name": "ebbflow",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "solver": "pnpm --filter @ebbflow/solver dev",
    "intents": "pnpm --filter @ebbflow/solver intents",
    "web": "pnpm --filter @ebbflow/web dev",
    "web:mainnet": "NEXT_PUBLIC_NEAR_NETWORK=mainnet pnpm --filter @ebbflow/web dev",
    "solver:mainnet": "NEAR_NETWORK=mainnet NEAR_RPC_URLS=https://rpc.mainnet.near.org pnpm --filter @ebbflow/solver dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
