NEAR_NETWORK=testnet
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# Defaults to deployments/<network>.json
EBBFLOW_CONTRACT=book.ebbflow-team.testnet
# Agent account. Omit for read-only tools. Key comes from AGENT_PRIVATE_KEY or
# ~/.near-credentials/<network>/<account>.json (near-cli save-to-legacy-keychain).
AGENT_ACCOUNT_ID=ebbflow-team-agent.testnet
# AGENT_PRIVATE_KEY=ed25519:...   # never commit
# Guard rails (whole tokens). The hard cap is the agent account's balance.
MAX_TRADE_BASE=10
MAX_TRADE_QUOTE=50
MAX_DAILY_QUOTE=200
PORT=8788
